# Optional — only needed if you want the audit ledger to anchor real blocks
# to a live Hedera Consensus Service topic. Without these, the backend runs
# fine in local-hash-chain-only mode (see app/services/ledger_service.py and
# app/services/hedera_service.py).
#
# Get testnet credentials free at https://portal.hedera.com
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_NETWORK=testnet
HEDERA_TOPIC_ID=

# CORS — comma-separated origins allowed to call the API. "*" is fine for
# local development (e.g. opening frontend/index.html directly).
CORS_ORIGINS=*
